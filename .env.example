# ─────────────────────────────────────────────────────────────────────────────
# Aroses environment reference. Copy to `.env.local` and fill in secrets.
# Only the REQUIRED section is needed to run the app; everything else has a
# sensible default and exists for tuning cost / speed / depth.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only writes (ingest jobs, metering, error_events).
SUPABASE_SERVICE_ROLE_KEY=
# Alternative names also accepted: SUPABASE_URL, SUPABASE_SECRET_KEY.
ANTHROPIC_API_KEY=

# ── Voice tutor (optional feature — leave unset to disable those surfaces) ──
OPENAI_API_KEY=            # Whisper STT (hold-to-talk)
# OPENAI_TRANSCRIBE_MODEL=whisper-1
DEEPGRAM_API_KEY=          # Live STT (WebSocket)
ELEVENLABS_API_KEY=        # TTS
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
# NEXT_PUBLIC_ELEVENLABS_VOICE_ID=
# ANTHROPIC_TUTOR_MODEL=          # voice reply model override
# ANTHROPIC_TUTOR_FAST_MODEL=

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# NOTE: student-facing billing UI is a code constant (BILLING_UI_ENABLED in
# src/lib/billing/feature-flag.ts), not an env flag.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDENT=
STRIPE_PRICE_ADVANCED=
STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_TOPUP=
# STRIPE_CONNECT_DEFAULT_COUNTRY=US
# MARKETPLACE_PLATFORM_FEE_PERCENT=20
# Sale UI is cosmetic for Student/Premium (percent inflate). Advanced uses a fixed
# compare-at in plans.ts (~~$65~~ $5) regardless of the sale percent.
# NEXT_PUBLIC_SUBSCRIPTION_SALE_ENABLED=1
# NEXT_PUBLIC_SUBSCRIPTION_SALE_PERCENT=30

# ── Auth / access control ────────────────────────────────────────────────────
# ALLOWED_AUTH_EMAIL_DOMAINS=berkeley.edu     # comma-separated allowlist
# AUTH_EMAIL_DOMAIN_ALLOWLIST_ENFORCED=1
# NEXT_PUBLIC_ALLOWED_AUTH_EMAIL_DOMAINS=
# NEXT_PUBLIC_SCHOOL_GOOGLE_HD=berkeley.edu   # Google OAuth hosted-domain hint
# NEXT_PUBLIC_SCHOOL_GOOGLE_PREFERRED_HINT=
# NEXT_PUBLIC_SCHOOL_ONLY_NO_EMAIL_PASSWORD=
# APP_ADMIN_EMAILS=                # comma-separated; bypass voice caps, admin UI
# APP_ADMIN_USER_IDS=
# NEXT_PUBLIC_APP_ADMIN_EMAILS=
# NEXT_PUBLIC_APP_ADMIN_USER_IDS=

# ── Course build profile (cost vs depth) ─────────────────────────────────────
# express | fast | balanced (default) | full. `balanced` = Haiku, 4–7 modules,
# 120k-char material budget. `full` = Sonnet, up to 18 modules, whole document.
# COURSE_BUILD_PROFILE=balanced

# Per-profile overrides (all optional ints; defaults live in
# src/lib/ai/study-generation.ts and src/lib/structure-plan-coverage.ts):
# COURSE_BALANCED_MAX_MODULES=7
# COURSE_BALANCED_MATERIAL_CHARS=120000
# COURSE_BALANCED_OUTLINE_MATERIAL_CHARS=
# COURSE_BALANCED_OUTLINE_MAX_TOKENS=
# COURSE_BALANCED_MODULE_MAX_TOKENS=
# COURSE_BALANCED_MAX_LESSON_TITLES=
# COURSE_BALANCED_QUIZ_MIN=
# COURSE_FULL_MAX_MODULES=18
# COURSE_FULL_MATERIAL_CHARS=
# COURSE_FULL_OUTLINE_MATERIAL_CHARS=
# COURSE_FULL_OUTLINE_MAX_TOKENS=
# COURSE_FULL_MODULE_MAX_TOKENS=
# COURSE_FULL_MAX_LESSON_TITLES=
# COURSE_FULL_QUIZ_MIN=
# COURSE_FULL_FREE_RESPONSE_MIN=
# COURSE_FAST_MAX_MODULES= / COURSE_FAST_MATERIAL_CHARS= / …
# COURSE_EXPRESS_MAX_MODULES= / COURSE_EXPRESS_MATERIAL_CHARS= / …
# COURSE_FREE_RESPONSE_MIN=
# COURSE_PLAN_MAX_TOKENS=

# Model overrides (default: Haiku for balanced/fast, Sonnet for full):
# ANTHROPIC_COURSE_MODEL=
# ANTHROPIC_OUTLINE_MODEL=
# ANTHROPIC_FAST_MODEL=
# ANTHROPIC_COURSE_QA_MODEL=
# ANTHROPIC_REFINE_MODEL=
# ANTHROPIC_REFINE_PLANNER_MODEL=
# ANTHROPIC_TRANSLATE_MODEL=

# Quantitative-consistency audit pass (default: on only for `full` profile):
# COURSE_NUMERIC_QA=1
# COURSE_TRANSLATE_CONCURRENCY=

# ── Structure planning (chunk-id plan → per-module sources) ──────────────────
# Auto-enabled for multi-file lectures and single files larger than the
# profile's material budget. Force on for everything with:
# STRUCTURE_PLANNING=1
# Use the deterministic (non-LLM) plan fallback only:
# STRUCTURE_PLANNING_LLM=0
# Disable the large-single-file routing:
# STRUCTURE_PLAN_LARGE_SOURCE=0

# ── PDF ingest pipeline tuning ───────────────────────────────────────────────
# PDF_INGEST_PAGE_RENDER=1          # enable figure/page-render pipeline (default off)
# PDF_INGEST_TABLE_VISION=0         # table vision on page images (default on)
# PDF_INGEST_TABLE_VISION_CONCURRENCY=
# PDF_INGEST_VISION_MODEL=
# PDF_INGEST_VISION_ALL_PAGES=
# PDF_INGEST_DEEP_VISION=
# PDF_INGEST_EMBEDDED_IMAGES=
# PDF_INGEST_PAGE_SNAPSHOTS=
# PDF_INGEST_STRUCTURAL_CROPS=
# PDF_INGEST_CROP_PADDING=
# PDF_INGEST_MAX_FIGURES_PER_PAGE=
# PDF_INGEST_MAX_SOURCE_IMAGES=
# PDF_INGEST_MODULE_CONCURRENCY=14  # parallel module generation calls
# PDF_INGEST_MODULE_BATCH_SIZE=
# PDF_INGEST_EXTRACT_CONCURRENCY=
# PDF_INGEST_OUTLINE_CONCURRENCY=
# PDF_INGEST_QUALIFY_CONCURRENCY=
# PDF_INGEST_ASSET_CLASSIFY_CONCURRENCY=
# PDF_INGEST_FINALIZE_VISUAL_BUDGET_MS=
# PDF_INGEST_STALL_PHASE1_MS=15000  # phase-1 auto-recovery threshold (0 = off)
# PDF_INGEST_PENDING_KICK_MS=4000   # pending-job re-kick threshold (0 = off)
# PDF_INGEST_WORKER_URL=            # override self-chaining worker base URL
# LOG_LESSON_GEN_INPUT=1            # dev: dump lesson LLM input diagnostics

# ── Anthropic global rate limiter (ingest generation only) ───────────────────
# Size to your Anthropic tier. See src/lib/ai/anthropic-rate-limit.ts.
# CLAUDE_MAX_RPM=600
# CLAUDE_MAX_ITPM=320000
# CLAUDE_MAX_OTPM=56000
# CLAUDE_OUTPUT_RESERVE_RATIO=
# CLAUDE_OUTPUT_RESERVE_FLOOR=

# ── Misc / ops ───────────────────────────────────────────────────────────────
# CRON_SECRET=                      # protects /api/process-pdf/worker
# NEXT_PUBLIC_SITE_URL=
# ACTIVITY_LOG_RETENTION_DAYS=
# NEXT_PUBLIC_LEGAL_EMAIL=
